#include "resource.h"
#include <windows.h>

IDR_CRASHINFO RCDATA "CrashInfo\\CLEO-CrashList.txt"

IDD_CRASH_DIALOG DIALOGEX 0, 0, 660, 380
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT | DS_CENTER
CAPTION "CLEO DebugUtils - GTA SA crash"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Critical GTA SA crash detected. The game has been minimized.", -1, 12, 10, 636, 16
    EDITTEXT IDC_CRASH_DETAILS, 12, 31, 636, 300, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_BORDER
    PUSHBUTTON "Copy", IDC_CRASH_COPY, 12, 340, 95, 24
    PUSHBUTTON "Open log", IDC_CRASH_OPEN_LOG, 116, 340, 105, 24
    DEFPUSHBUTTON "Exit game", IDC_CRASH_EXIT, 530, 340, 118, 24
END
